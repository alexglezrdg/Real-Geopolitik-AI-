# Phase 1 - Recommended Environment Configuration

Copy this to `.env` and adjust as needed for your deployment.

```bash
################################################################################
# X/TWITTER API CREDENTIALS
################################################################################
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_API_BEARER_TOKEN=your_bearer_token_here

################################################################################
# OPENAI / IMAGE GENERATION
################################################################################
OPENAI_API_KEY=your_openai_api_key_here

################################################################################
# DEPLOYMENT MODE
################################################################################
# Set to 1 to enable live posting to X/Twitter
X_LIVE=0

# Set to 1 to enable DALL-E image generation
IMAGE_LIVE=0

################################################################################
# SCHEDULING
################################################################################
# Enable scheduler (cron jobs)
SCHEDULER_ENABLED=1

# Cron schedule for autoposting (0 = hourly, see scheduler.ts for options)
SCHEDULE_CRON="0 * * * *"

################################################################################
# DEDUPLICATION SETTINGS (Phase 1 - CONSOLIDATED)
################################################################################

# Dedup TTL: how many days to keep dedup history
# Default: 14 (2 weeks)
# Lower = less memory, but more duplicates allowed
# Higher = more memory, but stricter dedup
DEDUPE_TTL_DAYS=14

# Dedup Hamming distance for near-duplicate detection (simhash)
# Default: 3 (allows 3-bit differences)
# Lower = stricter (fewer false negatives)
# Higher = looser (more duplicates through)
DEDUPE_HAMMING=3

# Max number of signatures to scan for near-dupes
# Default: 300 (scans last 300 posts)
DEDUPE_SIG_SCAN=300

# Debug dedup system (verbose logging)
DEDUPE_DEBUG=0

################################################################################
# TOPIC COOLDOWN SETTINGS (NEW - Phase 1)
################################################################################

# How many hours to prevent same topic from reposting
# Default: 72 (3 days)
# Lower = allow topic repeats more frequently
# Higher = stricter topic uniqueness
TOPIC_COOLDOWN_HOURS=72

################################################################################
# LLM / COST OPTIMIZATION (Phase 1 - HARDENED)
################################################################################

# Score threshold for using expensive LLM
# Default: 85
# Score < 85: uses deterministic template (~100 tokens)
# Score >= 85 AND has hard-geo keywords: uses LLM (~2000 tokens)
# Lower = more LLM calls (higher cost)
# Higher = fewer LLM calls (lower cost)
LLM_SCORE_THRESHOLD=85

# Enable LLM-based curator (alternative ranking path)
# Default: 0 (deterministic curator only)
CURATOR_LLM=0

# LLM API timeout (milliseconds)
# Default: 15000 (15 seconds)
LLM_TIMEOUT_MS=15000

################################################################################
# RSS SOURCES (Phase 1 - GDELT DISABLED)
################################################################################

# Enable GDELT geopolitical event API
# Default: 0 (disabled due to API content-type issues)
# Set to 1 to re-enable if API fixed
GDELT_ENABLED=0

# Max records from GDELT per query
GDELT_MAX_RECORDS=40

################################################################################
# POST LIMITS
################################################################################

# Maximum posts per day (safety limit)
# Default: 30
MAX_POSTS_PER_DAY=30

# Maximum post attempts before giving up
MAX_ATTEMPTS=3

################################################################################
# URL RESOLUTION
################################################################################

# Enable URL resolver debug (logs redirects)
URL_RESOLVE_DEBUG=0

# URL resolution timeout (milliseconds)
URL_RESOLVE_TIMEOUT=3000

# Max HTTP redirects to follow
URL_RESOLVE_MAX_REDIRECTS=5

################################################################################
# PROCESS LOCK (ANTI-PARALLEL)
################################################################################

# Enable process lock (prevents parallel execution)
# Default: 1 (always enabled)
PROCESS_LOCK_ENABLED=1

# Lock file stale timeout (milliseconds)
# Default: 1800000 (30 minutes)
PROCESS_LOCK_STALE_MS=1800000

# Debug process lock
LOCK_DEBUG=0

################################################################################
# LOGGING
################################################################################

# Post history debug logging
POST_HISTORY_DEBUG=0

# Curator debug logging
CURATOR_DEBUG=0

################################################################################
# DATABASE
################################################################################

# SQLite database path (default: data/bot.sqlite)
# DATABASE_PATH=/path/to/custom/bot.sqlite

################################################################################
# MONITORING & OBSERVABILITY
################################################################################

# Enable metrics logging (Phase 2 feature, not yet implemented)
METRICS_ENABLED=0

# JSON structured logging (Phase 2 feature, not yet implemented)
JSON_LOGGING=0

################################################################################
# NOTES FOR PHASE 1
################################################################################

# Phase 1 Priority Settings for Cost Optimization:
#
# 1. LLM_SCORE_THRESHOLD=85
#    - Only high-confidence stories get LLM
#    - Rest use deterministic template (~95% cost savings)
#    - Expected reduction: 70-90% on tokens
#
# 2. TOPIC_COOLDOWN_HOURS=72
#    - Prevents same geopolitical topic from posting multiple times
#    - Reduces redundancy, improves content diversity
#
# 3. GDELT_ENABLED=0
#    - Disabled by default due to API issues
#    - 25 RSS sources remain active (sufficient coverage)
#
# 4. DEDUPE_TTL_DAYS=14
#    - Consolidated to single 4-layer check (URL/FP/NEAR/TOPIC)
#    - Removed redundant 48h JSON check
#    - More efficient, same or better dedup quality
#
# Recommended Tuning:
# - Monitor actual costs for 7 days
# - If costs still high: raise LLM_SCORE_THRESHOLD to 90
# - If too many duplicates: raise TOPIC_COOLDOWN_HOURS to 96
# - If low-quality posts: lower LLM_SCORE_THRESHOLD to 80

################################################################################
